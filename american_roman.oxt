MAXAUD
{
NO_PILLS_04 = ~z~Maine ek bari beating li thi... lekin pain killers nahin the.
UNDEAD_09 = ~z~Shayad main abhi ready nahin tha kuch memorial ghar ki roof dekhein.
EXPLORE_ITEM_03 = ~z~Abhi kaam karna baki tha.
NO_PILLS_08 = ~z~Har kadam main pain jism mein chala raha tha - pain killers dhoondhna tha.
LOW_AMMO_03 = ~z~Mujhe kuch shots bache the; unhe count karna tha.
EXPLORE_ITEM_11 = ~z~Main apne kaam se dhoond raha tha.
FIND_AMMO_01 = ~z~Ammo dhoondhne se mujhe apni comfort zone mein aaya.
EXPLORE_ITEM_29 = ~z~Waqt aayega, phir uske liye waqt hoga.
EXPLORE_ITEM_27 = ~z~Priorities, Max - sehat pehle.
NO_PILLS_05 = ~z~Damage kaam kar raha tha... bari waqt pain killers nahin hain.
FIND_PILLS_03 = ~z~Pain killers se hi main apne aap ko thoda achha laga raha tha.
	FIND_AMMOA = Find_Ammo
	TAKE_PILLSSL = 017
EXPLORE_ITEM_14 = ~z~Mujhe priorities se kharaab ho raha tha waqt.
FIND_GUN_08 = ~z~Maine gun ko dekh kar koi bhi dhamki nahin di.
EXPLORE_ITEM_02 = ~z~Yeh waqt explore nahin karna tha.
0x1C2282D5 = ~z~Mujhe buri lagan lagi aur mere aankhon se duniya ghumne lage... Main jaldi hi kamzor ho raha tha.
NO_PILLS_06 = ~z~Mujhe pain killers nahin mil rahe the, lekin toh main zinda tha.
UNDEAD_02 = ~z~Main us guy ki soch se khushk ho raha tha... Usne socha tha ki main mar gaya hoon, lekin main nahin mara.
HAS_PILLS_08 = ~z~Mera jism bahut zyada dard se peeta tha, lekin pills ki dhoop mere pocket mein mere liye ek bari aasani thi.
FIND_PILLS_02 = ~z~Pain killers: Ek chhota sa beacon jahan se main dard se bach sakta hoon.
TAKE_PILLS_07 = ~z~Mujhe sirf do pills leni thi, aur dard aur dard ke saath saath soch aur ehsaas se bhi bachna tha.
FIND_AMMO_03 = ~z~Yeh waqt ammo dhoondhne ka tha.
EXPLORE_ITEM_01 = ~z~Mujhe kaam abhi bhi poora nahin tha.
	HAS_PILLSSL = 017
FIND_PILLS_01 = ~z~Pills - Main inhein ghar se bahar nahi chhod sakta tha.
LOW_AMMO_06 = ~z~Agar main ammo ke bina chala gaya toh main plan B par jaunga. Jis bhi plan B hoga.
