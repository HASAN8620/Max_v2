MAXAUD
{
NO_PILLS_04 = ~z~Mujhay kaafi thappad lag chuke thay... lekin painkillers khatam ho chuke thay.
UNDEAD_09 = ~z~Lagta hai abhi tak main kisi yaadgar makan ki chhat ko dekhne ke liye tayyar nahi tha.
EXPLORE_ITEM_03 = ~z~Abhi bhi kaam baaqi tha.
NO_PILLS_08 = ~z~Har qadam jo liya, dard mere jism mein tezi se daudta tha - mujhay kuch painkillers dhoondne padte.
LOW_AMMO_03 = ~z~Mere paas kuch ammo bacha tha; isko sahi istemal karna padega.
EXPLORE_ITEM_11 = ~z~Main apnay aap ko kaam se dhoka de raha tha.
FIND_AMMO_01 = ~z~Ammo dhoondna mujhay phir se meri comfort zone mein le aaya.
EXPLORE_ITEM_29 = ~z~Uske liye thodi der baad waqt hoga.
EXPLORE_ITEM_27 = ~z~Tarjeehat, Max.
NO_PILLS_05 = ~z~Nuksan bara asar daal raha tha... bilkul sahi waqt tha painkillers ke baghair.
FIND_PILLS_03 = ~z~Painkillers un chand cheezon mein se thi jo aaj kal mujhay apnay aap se khush mehsoos karwati thi.
	FIND_AMMOA = Find_Ammo
	TAKE_PILLSSL = 017
EXPLORE_ITEM_14 = ~z~Meri tarjeehat bigad rahi thi.
FIND_GUN_08 = ~z~Jab maine woh sahi hathiyar dekha jo main dhoond raha tha, to maine koi hichkichahat nahi ki.
EXPLORE_ITEM_02 = ~z~Abhi khoj karne ka waqt nahi tha.
0x1C2282D5 = ~z~Mujhe ulti si mehsoos hui aur meri nazar dhundhli ho gayi... main jaldi se gaib hota ja raha tha.
NO_PILLS_06 = ~z~Mere paas painkillers khatam ho gaye the, lekin kam se kam main zinda tha.
UNDEAD_02 = ~z~Main hamesha sochta rahunga ke us aadmi ke dimaag mein kya chal raha tha... usne socha ke main khatam ho gaya hoon. Thodi der baad, woh khatam ho gaya.
HAS_PILLS_08 = ~z~Mujhe kaafi zyada maara gaya tha, lekin jeb mein pills ki khanak ne mujhe tasalli di.
FIND_PILLS_02 = ~z~Painkillers: Dukh ki duniya mein ek chhota roshni ka chiragh.
TAKE_PILLS_07 = ~z~Sirf kuch pills jo dard aur takleef, aur jazbaat ko door bhaga dein.
FIND_AMMO_03 = ~z~Zyada ammo dhoondhne ka acha waqt tha.
EXPLORE_ITEM_01 = ~z~Mere paas abhi bhi adhoora kaam tha.
