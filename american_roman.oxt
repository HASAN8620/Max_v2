MAXAUD
{
NO_PILLS_04 = ~z~Maine ek bari ladaai li thi... lekin maine pain killers nahin the.
UNDEAD_09 = ~z~Shayad maine abhi tak aapke liye memorial ghar ka roof dekhna nahin seekha tha.
EXPLORE_ITEM_03 = ~z~Abhi bhi kaam karna tha.
NO_PILLS_08 = ~z~Har kadam main pain dene laga - maine pain killers dhoondhne ki zaroorat thi.
LOW_AMMO_03 = ~z~Maine kam shot rakhe hain; maine inhein count karna hoga.
EXPLORE_ITEM_11 = ~z~Main apne kaam se dhoond raha tha.
FIND_AMMO_01 = ~z~Ammo dhoondhne se main apni comfort zone mein aaya.
EXPLORE_ITEM_29 = ~z~Is minute mein uske liye samay hoga.
EXPLORE_ITEM_27 = ~z~Pehle priorities, Max.
NO_PILLS_05 = ~z~Damage ka asar ho raha tha... acha waqt pain killers nahin hone ka.
FIND_PILLS_03 = ~z~Pain killers mere liye ek hi cheezen thi jo mere liye achhi lagti thi.
	FIND_AMMOA = Find_Ammo
	TAKE_PILLSSL = 017
EXPLORE_ITEM_14 = ~z~Mujhe priorities ka khata hai tha.
FIND_GUN_08 = ~z~Maine dekha jab maine apni zaroorat ki gun dekhi thi.
EXPLORE_ITEM_02 = ~z~Yeh waqt explore nahi karna tha.
0x1C2282D5 = ~z~Mujhe bhook lag rahi thi aur mere aankhon mein dhoop lag rahi thi... Main taraab ho raha tha.
NO_PILLS_06 = ~z~Main pain killer nahi tha, lekin toh main jee raha tha.
UNDEAD_02 = ~z~Main us guy ki kya sochti thi... woh socha tha ki main mar gaya hoon. Lekin main nahin mara.
HAS_PILLS_08 = ~z~Main zyada zakhmi tha, lekin mere pocket mein pain killer ka sound sunne se mujhe thoda aaram mil raha tha.
FIND_PILLS_02 = ~z~Pain killer: Ek chhota sa beacon jahan dard hai.
TAKE_PILLS_07 = ~z~Ek do pills lena aur dard aur pain chhodna... aur soch aur ehsaas chhodna.
FIND_AMMO_03 = ~z~Yeh waqt ammo dhoondhna tha.
EXPLORE_ITEM_01 = ~z~Mujhe abhi bhi kaam hai.
	HAS_PILLSSL = 017
FIND_PILLS_01 = ~z~Pills - Main inko ghar se nahi nikalna chahta tha.
LOW_AMMO_06 = ~z~Agar main ammo nahi milta toh main plan B par jaunga. Kya hoga woh.
0x3165AD5B = ~z~Mera sehat mere haath mein thi... Main apne aap ko apne haath mein dekh raha tha.
