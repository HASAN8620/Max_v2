MAXAUD
{
NO_PILLS_04 = ~z~Maine ek badi ladaai li thi... lekin maine pain killers nahin the.
UNDEAD_09 = ~z~Shayad maine abhi aapni jaan se khelna nahin seekha tha.
EXPLORE_ITEM_03 = ~z~Abhi bhi kaam karna tha.
NO_PILLS_08 = ~z~Har kadam maine liya, mere shareer mein dard chala gaya - maine pain killers khojne ki zaroorat thi.
LOW_AMMO_03 = ~z~Maine kuch shot bache the; maine unhein count karne ki zaroorat thi.
EXPLORE_ITEM_11 = ~z~Maine apne kaam se dabaav mein aaya tha.
FIND_AMMO_01 = ~z~Ammo khojna mere comfort zone mein tha.
EXPLORE_ITEM_29 = ~z~Is minute mein uske liye samay hoga.
EXPLORE_ITEM_27 = ~z~Urgent hai, Max.
NO_PILLS_05 = ~z~Dard ka nuksaan laga raha tha... achha samay pain killers nahin hone ka.
FIND_PILLS_03 = ~z~Pain killers mere liye ek hi cheez thi jo mujhe khush karne mein madad karti thi.
	FIND_AMMOA = Find_Ammo
	TAKE_PILLSSL = 017
EXPLORE_ITEM_14 = ~z~Mujhe apne prathayon se kharaab ho raha tha.
FIND_GUN_08 = ~z~Maine kabhi bhi apne liye zarooratmand hawa ki talash mein nahin chhodna.
EXPLORE_ITEM_02 = ~z~Yeh samay khud ki talash nahin tha.
0x1C2282D5 = ~z~Mujhe bimari lag rahi thi aur mere aankhon mein duniya ghum rahi thi... Main tareekh se kam ho raha tha.
NO_PILLS_06 = ~z~Mujhe dard nivaarak nahin the, lekin to main zinda tha.
UNDEAD_02 = ~z~Main kabhi bhi yeh sochta rahunga ki uske dimaag mein kya chal raha tha... Vah sochta tha ki main mar gaya hoon. Phir bhi main tha.
HAS_PILLS_08 = ~z~Main bahut zyada zakhm utha hua tha, lekin mere pocket mein dard nivaarak ka rattle mere liye ek aasaan ban gaya tha.
FIND_PILLS_02 = ~z~Dard nivaarak: Ek chhoti si aasha ek duniya mein dard ke.
TAKE_PILLS_07 = ~z~Kuch dard nivaarak lena aur dard aur dard ke saath saath soch aur bhavnaon ko dhoona.
FIND_AMMO_03 = ~z~Yeh samay ammo ki talash karne ka tha.
EXPLORE_ITEM_01 = ~z~Main abhi bhi apne kaam ko pura nahin kar sakta tha.
	HAS_PILLSSL = 017
